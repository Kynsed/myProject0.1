// Banco de animacoes do player (formato proprio, ver SpriteBank.cs)
//
//   anim <id> <fps> <loop|once> <caminho no atlas>
//        frames = todas as subtexturas <caminho>00, <caminho>01, ... (Atlas)
//   alias <id> <id de destino>
//        o Player herdado do port pede 40 ids; os que a arte nao cobre caem
//        num alias em vez de quebrar (Sprite.Play de id inexistente joga)
//   origin <x> <y>
//        ancora do quadro em px. Os PNGs sao 16x16 com o corpo no rodape,
//        entao (8,16) poe os pes exatamente em Player.Position

origin 8 16

anim idle       6  loop  player/idle
anim walk      10  loop  player/walk
anim run       14  loop  player/run
anim jump       1  once  player/jump
anim fall       1  once  player/fall
anim dash       1  once  player/dash
anim duck       1  once  player/duck
anim wallslide  1  once  player/wallslide
anim lookUp     1  once  player/lookUp

// --- ids que o Player pede e a arte ainda nao cobre ---
alias asleep             idle
alias bubble             idle
alias danger             idle
alias edge               idle
alias edgeBack           idle
alias pickup             idle
alias throw              idle
alias tired              idle
alias swimIdle           idle
alias swimUp             idle
alias swimDown           idle

alias push               walk
alias skid               walk

alias runFast            run
alias runSlow            run
alias runStumble         run
alias runWind            run

alias jumpFast           jump
alias jumpSlow           jump
alias flip               jump
alias launch             jump
alias startStarFly       jump

alias fallFast           fall
alias fallSlow           fall
alias fallPose           fall
alias bigFall            fall
alias dangling           fall
alias launchRecover      fall

alias bigFallRecover     duck

alias climb              wallslide
alias climbUp            wallslide
alias climbLookBackStart wallslide

alias dreamDashIn        dash
alias dreamDashOut       dash
